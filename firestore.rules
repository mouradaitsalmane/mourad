rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection (Public Profiles and Private PII info)
    match /users/{userId} {
      allow read: if true;
      
      // Create is allowed for the authenticated owner
      allow create: if isOwner(userId) && 
                      incoming().uid == userId;

      // Update is allowed for the owner, but guards against self-escalation
      allow update: if isOwner(userId) &&
                      incoming().uid == existing().uid &&
                      (!incoming().diff(existing()).affectedKeys().hasAny(['rating', 'reviewsCount', 'isVerifiedTasker', 'role']));

      allow delete: if false;

      // Private contact info containing PII (Split collection strategy)
      match /private/{doc} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Tasks and Offers (Bids)
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      
      // Create task validation (Identity, budget, titles size, posterId integrity)
      allow create: if isSignedIn() &&
                      isValidId(taskId) &&
                      incoming().posterId == request.auth.uid &&
                      incoming().title is string && incoming().title.size() <= 100 &&
                      incoming().description is string && incoming().description.size() <= 1000 &&
                      incoming().budget is number && incoming().budget > 0 && incoming().budget <= 100000 &&
                      incoming().status == 'open';

      // Update task validation (State transition checks, immutability, terminal locking)
      allow update: if isSignedIn() &&
                      existing().status != 'completed' && 
                      existing().status != 'cancelled' &&
                      incoming().posterId == existing().posterId &&
                      incoming().createdAt == existing().createdAt &&
                      (
                        // Poster updating task or status
                        isOwner(existing().posterId) ||
                        // Tasker accepting / updating assignment status
                        (existing().taskerId == request.auth.uid || incoming().taskerId == request.auth.uid)
                      );

      allow delete: if false;

      // Subcollection Offers (Bids)
      match /offers/{offerId} {
        allow read: if isSignedIn();
        
        // Taskers cannot bid on their own task, and must lock offer taskerId to request.auth.uid
        allow create: if isSignedIn() &&
                        isValidId(offerId) &&
                        get(/databases/$(database)/documents/tasks/$(taskId)).data.posterId != request.auth.uid &&
                        get(/databases/$(database)/documents/tasks/$(taskId)).data.status == 'open' &&
                        incoming().taskerId == request.auth.uid;

        // Only the offer owner can edit/update their bid
        allow update: if isSignedIn() &&
                        incoming().taskerId == existing().taskerId &&
                        existing().taskerId == request.auth.uid;

        allow delete: if isSignedIn() &&
                        existing().taskerId == request.auth.uid;
      }
    }

    // 3. Reviews
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                      incoming().reviewerId == request.auth.uid;
      allow update: if isSignedIn() && 
                      existing().reviewerId == request.auth.uid && 
                      incoming().reviewerId == existing().reviewerId;
      allow delete: if false;
    }

    // 4. Chat Messages (Enforces message ownership & room participation check)
    match /chatMessages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.roomId.matches('.*' + request.auth.uid + '.*')
      );
      allow create: if isSignedIn() && 
                      incoming().senderId == request.auth.uid &&
                      incoming().text is string && incoming().text.size() <= 5000;
      allow update, delete: if false; // Messages are immutable
    }

    // 5. Transactions (Server-mediated only, read-only for transaction owners)
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userUid == request.auth.uid);
      allow write: if false; // All transactions are processed and written securely server-side
    }

    // 6. Workers Alias (Enforce worker ownership)
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if isOwner(workerId);
    }

    // 7. Notifications (Standard users can only read and mark their own notifications as read)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid && 
                      incoming().diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // 8. Categories (Read-only for clients/workers, modified only via secure admin privileges)
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. Dynamic requested rules (Secured against direct database tampering)
    match /requests/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || incoming().userId == request.auth.uid);
    }

    match /jobs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || resource.data.workerId == request.auth.uid || incoming().workerId == request.auth.uid);
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false; // Managed securely server-side
    }

    // 10. Additional collections (for resilience)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /files/{fileId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && (request.resource.data.userId == resource.data.userId);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /fraud_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /faqs/{faqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
